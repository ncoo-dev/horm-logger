{
    "name": "ncoo-dev/horm-logger",
    "description": "Awesome package that allow to log HTTP Outbound Request for HORM",
    "keywords": [
        "ncoo-dev",
        "horm-logger"
    ],
    "homepage": "https://github.com/ncoo-dev/horm-logger",
    "license": "MIT",
    "authors": [
        {
            "name": "Dominique Thomas",
            "email": "domthomas@ncoo-dev.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^11.18",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "pestphp/pest": "^2.20",
        "laravel/pint": "^1.0",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "NcooDev\\HormLogger\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NcooDev\\HormLogger\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
            "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "NcooDev\\HormLogger\\HormLoggerServiceProvider"
            ]
        },
        "aliases": {
            "Horm": "NcooDev\\HormLogger\\Facade"
        }
    }
}
